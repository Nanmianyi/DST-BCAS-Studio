#if defined( GL_ES )
precision mediump float;
#endif

// ============================================================================
//  BCAS Studio - glow pyramid blur pass (Kawase / dual filtering, 2026-09 v2)
//
//  4 taps only: samples at (+-s + 0.5, +-s + 0.5) texels with linear
//  filtering, where the stride s is baked per build (2 / 4 / 8). Growing
//  strides across the pyramid give the wide soft falloff a long-tail bloom
//  needs, at a fraction of the taps of the old 9-tap gaussian chain.
//
//  Runs at 1/4 resolution (0.25x RT), input = previous pyramid stage.
//
//  SAMPLER_PARAMS {w, h, 1/w, 1/h} is engine magic for sampler effects:
//  the engine fills it per sampler RT and it must be bound from Lua with
//  SetEffectUniformVariables(id, UniformVariables.SAMPLER_PARAMS), but it
//  must NEVER go through AddUniformVariable.
//
//  KAWASE_STRIDE is a build token replaced by build_ksh.py per variant.
//
//  NOTE FOR MAINTAINERS: pure ASCII only (ANGLE rejects anything else).
// ============================================================================

uniform sampler2D SAMPLER[1];
uniform vec4 SAMPLER_PARAMS;

varying vec2 PS_TEXCOORD0;

#define STRIDE KAWASE_STRIDE

void main()
{
    vec2 px = SAMPLER_PARAMS.zw;
    float s = STRIDE + 0.5;
    vec2 off = vec2(px.x * s, px.y * s);

    vec4 sum = texture2D(SAMPLER[0], PS_TEXCOORD0.xy + vec2( off.x,  off.y))
             + texture2D(SAMPLER[0], PS_TEXCOORD0.xy + vec2( off.x, -off.y))
             + texture2D(SAMPLER[0], PS_TEXCOORD0.xy + vec2(-off.x,  off.y))
             + texture2D(SAMPLER[0], PS_TEXCOORD0.xy + vec2(-off.x, -off.y));

    gl_FragColor = sum * 0.25;
}
