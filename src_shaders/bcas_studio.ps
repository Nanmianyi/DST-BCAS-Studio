#if defined( GL_ES )
precision highp float;
#endif

// ============================================================================
//  BCAS Studio - PASS 2/2: deconvolution + bilateral sharpen + composite
//
//  Pipeline:
//    5-tap SIMD sample -> inverse laplacian deconvolution (de-smears bilinear
//    atlas blur without position warp) -> bilateral detail extraction
//    -> AURA anti-overshoot envelope -> vignette/grain -> TPDF dither -> out
//
//  NOTE: pure ASCII only. Minified source must stay under ~3800 bytes.
// ============================================================================

uniform sampler2D SAMPLER[1];

#define SRC_IMAGE        SAMPLER[0]

uniform vec4 SCREEN_PARAMS;
uniform vec4 BCAS_SHARPEN;
uniform vec4 BCAS_SHARP2;
uniform vec4 BCAS_AURA;
uniform vec4 BCAS_ATMO;
uniform vec4 BCAS_DECONV;

varying vec2 PS_TEXCOORD0;

#define DECONV_STRENGTH BCAS_DECONV.x
#define DECONV_GATE     BCAS_DECONV.y
#define DECONV_PENETR   BCAS_DECONV.z

#define STRENGTH      BCAS_SHARPEN.x
#define NOISE_REDUCE  BCAS_SHARPEN.y
#define ANTI_RING     BCAS_SHARPEN.z
#define DARK_PROT     BCAS_SHARPEN.w

#define RANGE_SIGMA   BCAS_SHARP2.x
#define SPATIAL_SIGMA BCAS_SHARP2.y
#define CENTER_W      BCAS_SHARP2.z
#define NOISE_FLOOR   BCAS_SHARP2.w

#define AR_THRESH     BCAS_AURA.x
#define AR_OVER_L     BCAS_AURA.y
#define AR_OVER_D     BCAS_AURA.z
#define CHROMA_PROT   BCAS_AURA.w

#define VIGNETTE      BCAS_ATMO.x
#define GRAIN         BCAS_ATMO.y
#define TIME          BCAS_ATMO.z

float slt(float x, float s)
{
    s = max(s, 1e-6);
    return s * x / (abs(x) + s);
}

void main()
{
    vec2 px = SCREEN_PARAMS.zw;
    if (px.x <= 0.0 || px.y <= 0.0) {
        px = vec2(1.0 / 1280.0, 1.0 / 720.0);
    }

    vec3 e  = texture2D(SRC_IMAGE, PS_TEXCOORD0).rgb;
    vec3 b3 = texture2D(SRC_IMAGE, PS_TEXCOORD0 + vec2( 0.0, -px.y)).rgb;
    vec3 d3 = texture2D(SRC_IMAGE, PS_TEXCOORD0 + vec2(-px.x,  0.0)).rgb;
    vec3 f3 = texture2D(SRC_IMAGE, PS_TEXCOORD0 + vec2( px.x,  0.0)).rgb;
    vec3 h3 = texture2D(SRC_IMAGE, PS_TEXCOORD0 + vec2( 0.0,  px.y)).rgb;

    vec3 WY = vec3(0.25, 0.5, 0.25);
    vec3 CO = vec3(1.0, 0.0, -1.0);
    vec3 CG = vec3(-0.5, 1.0, -0.5);
    vec4 nbrY = vec4(dot(b3, WY), dot(d3, WY), dot(f3, WY), dot(h3, WY));
    vec4 Co4  = vec4(dot(b3, CO), dot(d3, CO), dot(f3, CO), dot(h3, CO));
    vec4 Cg4  = vec4(dot(b3, CG), dot(d3, CG), dot(f3, CG), dot(h3, CG));

    float Ye  = dot(e, WY);
    float Coe = dot(e, CO);
    float Cge = dot(e, CG);

    vec4 diffY = nbrY - Ye;

    // === 1. Local statistics ===
    float madY = dot(abs(diffY), vec4(0.25));
    float mco  = dot(abs(Co4 - Coe), vec4(0.25));
    float mcg  = dot(abs(Cg4 - Cge), vec4(0.25));
    float mc   = 0.5 * (mco + mcg);

    float eu  = clamp(1.0 - (abs(nbrY.x - nbrY.w) + abs(nbrY.y - nbrY.z)) / (4.0 * madY + 1e-6), 0.0, 1.0);
    float iso = clamp((madY - 2.0 * min(madY, mc)) / max(madY, 1e-6), 0.0, 1.0);

    // === 2. Bilateral base ===
    float sg = clamp(RANGE_SIGMA * (1.0 + 0.6 * (1.0 - clamp(madY / 0.05, 0.0, 1.0))), 0.01, 2.0);
    float i2 = 0.5 / max(sg * sg, 1e-6);
    float ws = SPATIAL_SIGMA > 0.001 ? exp(-0.5 / max(SPATIAL_SIGMA * SPATIAL_SIGMA, 1e-4)) : 1.0;
    float cw = max(CENTER_W, 0.0);
    vec4 soft = diffY * diffY + vec4(1.5e-5);
    vec4 w4 = exp(-soft * i2) * ws;
    float Ybase = (dot(nbrY, w4) + Ye * cw) / max(dot(w4, vec4(1.0)) + cw, 1e-6);

    // === 3. Asymmetric ink deconvolution (ZERO white ringing halo) ===
    // lapY > 0: current pixel is in the dark valley, neighbours are brighter -> deepen!
    // lapY < 0: current pixel is in the bright shoulder -> DO NOT LIFT (prevents white halo)
    float lapY = dot(diffY, vec4(0.25));
    float edgeActivity = smoothstep(DECONV_GATE * 0.4, DECONV_GATE * 1.6, madY);
    // Strict one-way deepening: only negative corrections (deepening ink), zero positive brightening!
    float inkDeepen = min(0.0, -lapY) * edgeActivity * (DECONV_STRENGTH * 2.2);

    // === 4. High-frequency bilateral detail ===
    float det = (Ye - Ybase) * mix(1.0, 0.6, iso) * mix(1.0, 0.8, eu);

    float nf = max(NOISE_FLOOR, 0.0078);
    float nm = mix(1.0 - NOISE_REDUCE, 1.0, clamp(madY / nf, 0.0, 1.0));
    float cpg = 1.0 - CHROMA_PROT * clamp(mc / (madY + 1e-6), 0.0, 1.0);

    // Dynamic headroom ceiling
    float s0 = 0.16 * (1.0 + 3.0 * clamp(madY / 0.05, 0.0, 1.0));
    s0 *= (0.7 + 0.6 * (4.0 * Ye * (1.0 - Ye)));
    s0 *= (0.75 + 0.25 * cpg);

    float raw = det * (STRENGTH * 0.85) * nm * cpg;
    float y0 = Ye + slt(max(0.0, raw), s0 * 0.22) + slt(min(0.0, raw), s0);

    // Dark protect: protects low-contrast ground/night noise
    float th = max(1e-6, nf * DARK_PROT);
    float y1 = mix(Ye, y0, clamp((y0 - th) / max(0.04, th), 0.0, 1.0));

    // === 5. AURA anti-overshoot (strictly limits light-halo ringing, preserves dark ink) ===
    float Ysharp = y1;
    if (ANTI_RING > 0.0 && madY > AR_THRESH) {
        float mn5 = min(Ye, min(min(nbrY.x, nbrY.y), min(nbrY.z, nbrY.w)));
        float mx5 = max(Ye, max(max(nbrY.x, nbrY.y), max(nbrY.z, nbrY.w)));
        float md = max(min(mx5 - Ye, Ye - mn5), 1e-6);
        float sd = y1 - Ye;
        Ysharp = Ye + slt(max(0.0, sd), md + AR_OVER_L * 0.45) + slt(min(0.0, sd), max(Ye - mn5, 0.05) + AR_OVER_D * 4.0);
        Ysharp = min(Ysharp, mx5);
    }

    // === 6. Asymmetric ink steepening (strictly subtractive, never lift the bright shoulder) ===
    Ysharp += inkDeepen * nm * cpg;
    Ysharp = min(Ysharp, Ye + 0.004);
    Ysharp = clamp(Ysharp, 0.0, 1.0);

    float sc = 1.0;
    if (Ye > 1e-6) {
        sc = mix(1.0, clamp(Ysharp / Ye, 0.82, 1.0), smoothstep(0.0, 0.1, Ye));
    }
    float tmp = Ysharp - 0.5 * sc * Cge;
    vec3 color = vec3(tmp + 0.5 * sc * Coe, sc * Cge + tmp, tmp - 0.5 * sc * Coe);

    // ========================================================================
    // Atmosphere
    // ========================================================================
    if (VIGNETTE > 0.001) {
        vec2 vc = PS_TEXCOORD0 - 0.5;
        color *= 1.0 - VIGNETTE * smoothstep(0.35, 0.95, dot(vc, vc) * 2.4);
    }

    if (GRAIN > 0.001) {
        vec2 gp = PS_TEXCOORD0 * SCREEN_PARAMS.xy + vec2(TIME * 61.7, TIME * 23.1);
        float n = fract(dot(gp, vec2(12.9898, 78.233)) * 43758.5453);
        color += (n - 0.5) * GRAIN * 0.13;
    }

    float d1 = fract(dot(gl_FragCoord.xy, vec2(12.9898, 78.233)) * 43758.5453);
    float d2 = fract(dot(gl_FragCoord.yx, vec2(78.233, 12.9898)) * 24634.6345);
    color += (d1 - d2) * (1.0 / 512.0);

    gl_FragColor = vec4(clamp(color, 0.0, 1.0), 1.0);
}
