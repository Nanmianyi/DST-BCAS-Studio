#if defined( GL_ES )
precision highp float;
#endif

// ============================================================================
//  BCAS Studio - PASS 1/2: cinematic color engine
//
//  Pipeline (user-directed): grade FIRST so the dynamic range is stable
//  before sharpening; atmosphere moves to pass 2 so grain is generated
//  after the sharpener (the sharpener never sees or amplifies grain).
//  Chain: bcas_cinema (this) -> bcas_studio (sharpen + vignette/grain).
//
//  8-bit hardening here:
//   * ACES linearization uses the sRGB EOTF (linear toe) instead of a raw
//     pow(x, 2.2), which crushes the first ~16 dark levels of an 8-bit
//     buffer into a single value (black-hole noise patches).
//   * TPDF dither (+-0.5 LSB, triangle) right before writing the 8-bit
//     intermediate target: kills the banding contours that strong grading
//     tears into quantized steps.
//
//  NOTE FOR MAINTAINERS: this file MUST stay pure ASCII (ANGLE rejects
//  non-ASCII with "invalid character" and the effect silently dies).
//  The MINIFIED source must stay under ~3800 bytes (build_ksh.py guards).
//
//  Uniform layout (must match AddUniformVariable calls in modmain.lua):
//    SCREEN_PARAMS  {w, h, 1/w, 1/h}  - engine auto-filled, never register in Lua
//    BCAS_GRADE_A   x=exposureEV y=temp z=tint(green-magenta) w=saturation(global)
//    BCAS_GRADE_B   x=vibrance y=contrast z=lightness w=gamma
//    BCAS_EXTRA     x=ACES mix
//    BCAS_CDL_S     xyz=CDL slope (RGB)   w=secondary CDL enable
//    BCAS_CDL_O     xyz=CDL offset (RGB)  w=highlight desaturate
//    BCAS_CDL_P     xyz=CDL power  (RGB)
//    BCAS_SEC_S     xyz=secondary slope (RGB)
//    BCAS_SEC_O     xyz=secondary offset (RGB)  w=original mix
//    BCAS_SEC_P     xyz=secondary power (RGB)
//
//  CDL (from the validated BCAS_Workspace V1.5.fx):
//    out = pow(saturate(x * slope + offset), power)
//  Grading is display-domain (our chain has no linear section); the fx
//  applied CDL pre-tonemap in linear - close enough for taste knobs.
// ============================================================================

uniform sampler2D SAMPLER[1];

#define SRC_IMAGE        SAMPLER[0]

// NOTE: do NOT declare SCREEN_PARAMS in this pass. It is unused here (the
// atmosphere pass owns the pixel-size math), the GLSL compiler strips
// unused uniforms, and if the ksh entry table still lists it the engine
// gets index 0xFFFFFFFF and native-asserts to desktop (2026-08, tested).
// Rule: the entry table = actually-used uniforms only.
uniform vec4 BCAS_GRADE_A;
uniform vec4 BCAS_GRADE_B;
uniform vec4 BCAS_EXTRA;
uniform vec4 BCAS_CDL_S;
uniform vec4 BCAS_CDL_O;
uniform vec4 BCAS_CDL_P;
uniform vec4 BCAS_SEC_S;
uniform vec4 BCAS_SEC_O;
uniform vec4 BCAS_SEC_P;

varying vec2 PS_TEXCOORD0;

#define EXPOSURE_EV   BCAS_GRADE_A.x
#define WB_TEMP       BCAS_GRADE_A.y
#define WB_TINT       BCAS_GRADE_A.z
#define SATURATION    BCAS_GRADE_A.w

#define VIBRANCE      BCAS_GRADE_B.x
#define CONTRAST      BCAS_GRADE_B.y
#define LIGHTNESS     BCAS_GRADE_B.z
#define GAMMA         BCAS_GRADE_B.w

#define FILMIC        BCAS_EXTRA.x

#define SLOPE         BCAS_CDL_S.xyz
#define SEC_ON        BCAS_CDL_S.w
#define OFFSET        BCAS_CDL_O.xyz
#define HL_DESAT      BCAS_CDL_O.w
#define POWER         BCAS_CDL_P.xyz
#define SEC_SLOPE     BCAS_SEC_S.xyz
#define SEC_OFFSET    BCAS_SEC_O.xyz
#define ORIGINAL_MIX  BCAS_SEC_O.w
#define SEC_POWER     BCAS_SEC_P.xyz

// CDL (faithful): out = pow(saturate(x * slope + offset), power)
vec3 ApplyCDL(vec3 x, vec3 slope, vec3 offset, vec3 power)
{
    x = clamp(x * slope + offset, 0.0, 1.0);
    return pow(max(x, vec3(1e-6)), power);
}

// sRGB EOTF with a linear toe: pow(1/255, 2.2) collapses the first ~16
// dark levels of an 8-bit buffer to ~0; the toe keeps them alive.
vec3 ToLinear(vec3 c)
{
    vec3 hi = pow((c + 0.055) / 1.055, vec3(2.4));
    return mix(c / 12.92, hi, step(vec3(0.04045), c));
}

vec3 ToGamma(vec3 c)
{
    vec3 hi = 1.055 * pow(max(c, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
    return mix(c * 12.92, hi, step(vec3(0.0031308), c));
}

float HighlightMask(float Y)
{
    float t = clamp((Y - 0.6) / 0.4, 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

void main()
{
    vec3 color = texture2D(SRC_IMAGE, PS_TEXCOORD0).rgb;
    vec3 orig = color;

    // exposure (EV)
    color *= exp2(EXPOSURE_EV);

    // white balance: temp (orange-blue) + tint (green-magenta), gains
    // normalized to keep luma neutral
    vec3 wb = vec3(exp2(0.20 * WB_TEMP), exp2(0.12 * WB_TINT), exp2(-0.20 * WB_TEMP));
    color *= wb * (3.0 / (wb.r + wb.g + wb.b + 1e-6));

    // CDL primary, then blend in the secondary by its enable flag
    vec3 cdl = ApplyCDL(color, SLOPE, OFFSET, POWER);
    vec3 cdl2 = ApplyCDL(cdl, SEC_SLOPE, SEC_OFFSET, SEC_POWER);
    color = mix(cdl, cdl2, clamp(SEC_ON, 0.0, 1.0));

    // lightness (additive)
    color += LIGHTNESS;

    // contrast (pivot 0.5)
    color = (color - 0.5) * (1.0 + CONTRAST) + 0.5;

    // gamma (display-domain slider)
    color = pow(max(color, vec3(0.0)), vec3(1.0 / max(GAMMA, 0.01)));

    // filmic curve (ACES fitted) in real linear light:
    // sRGB-EOTF linearize (toe-protected) -> curve -> re-encode -> mix
    if (FILMIC > 0.001) {
        vec3 lin = ToLinear(clamp(color, 0.0, 1.0));
        vec3 num = lin * (2.51 * lin + 0.03);
        vec3 den = lin * (2.43 * lin + 0.59) + 0.14;
        color = mix(color, ToGamma(clamp(num / den, 0.0, 1.0)), FILMIC);
    }

    // saturation group (faithful to the fx CCE):
    // vibrance protects already-saturated px, WL weights midtones,
    // highlight desaturate pulls hot spots back toward white.
    float yt = 0.25 * color.r + 0.5 * color.g + 0.25 * color.b;
    float ct = color.g - 0.5 * (color.r + color.b);
    float co = color.r - color.b;
    float cmag = sqrt(co * co + ct * ct);
    float vibMask = clamp(1.0 - cmag / 0.6, 0.0, 1.0);
    float wl = pow(clamp(4.0 * yt * (1.0 - yt), 0.0, 1.0), 1.1);
    float satFactor = max(SATURATION, 0.0);
    satFactor += VIBRANCE * (vibMask * wl);
    satFactor *= 1.0 - HighlightMask(dot(color, vec3(0.2126, 0.7152, 0.0722))) * HL_DESAT;
    color = mix(vec3(yt), color, satFactor);

    // original mix (0 = fully processed, 1 = raw input)
    color = mix(color, orig, clamp(ORIGINAL_MIX, 0.0, 1.0));

    // TPDF dither, +-0.5 LSB triangle: the graded output is written to an
    // 8-bit intermediate target; without dither the stretched steps show
    // up as banding contours (and pass 2 would sharpen the stair edges).
    float d1 = fract(dot(gl_FragCoord.xy, vec2(12.9898, 78.233)) * 43758.5453);
    float d2 = fract(dot(gl_FragCoord.yx, vec2(78.233, 12.9898)) * 24634.6345);
    color += (d1 - d2) * (1.0 / 512.0);

    gl_FragColor = vec4(clamp(color, 0.0, 1.0), 1.0);
}
