#if defined( GL_ES )
precision highp float;
#endif

// ============================================================================
//  BCAS Studio - bloom composite (2026-09 v5, mip pyramid)
//
//  One full-resolution pass. Inputs:
//    SAMPLER[0] = SRC  : chain input (studio sharpen output)
//    SAMPLER[1] = L0   : prefiltered core   (1/4 res)
//    SAMPLER[2] = L1   : mip level          (1/8 res)
//    SAMPLER[3] = L2   : mip level          (1/16 res)
//    SAMPLER[4] = L3   : widest mip level   (1/32 res)
//
//  A progressive mip pyramid replaces the old fixed-1/4-res Kawase chain:
//  every level is a clean 2x2 box downsample, so nothing undersamples into
//  blocks or diagonal streaks. The four levels are summed with a weight
//  profile blended by SPREAD, giving a smooth, energy-decreasing falloff
//  (no uniform "disc" wrapped around objects).
//
//  Removed the old light-wrap haze and edge rim from the defaults (both
//  were what looked like a translucent film over the scene); they remain
//  reachable from the panel but default to 0.
//
//  Uniform layout (matches bcas_state.lua packing):
//    BCAS_GLOW   x=intensity y=threshold z=knee w=warmth
//    BCAS_GLOW2  x=spread y=saturation z=highlight compression w=breathing
//    BCAS_GLOW3  x=tail lift y=light wrap z=rim w=(unused)
//    SCREEN_PARAMS xy=size zw=1/size
//
//  NOTE FOR MAINTAINERS: this file MUST stay pure ASCII (ANGLE rejects
//  non-ASCII with "invalid character" and the effect silently dies).
// ============================================================================

uniform sampler2D SAMPLER[5];

uniform vec4 BCAS_GLOW;
uniform vec4 BCAS_GLOW2;
uniform vec4 BCAS_GLOW3;
uniform vec4 SCREEN_PARAMS;

varying vec2 PS_TEXCOORD0;

float bcas_luma(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main()
{
    vec2 uv = PS_TEXCOORD0.xy;
    vec3 src = texture2D(SAMPLER[0], uv).rgb;
    vec3 l0  = texture2D(SAMPLER[1], uv).rgb;
    vec3 l1  = texture2D(SAMPLER[2], uv).rgb;
    vec3 l2  = texture2D(SAMPLER[3], uv).rgb;
    vec3 l3  = texture2D(SAMPLER[4], uv).rgb;

    // weight profiles: tight hot core -> long soft tail
    vec4 wTight = vec4(0.55, 0.25, 0.13, 0.07);
    vec4 wLong  = vec4(0.18, 0.24, 0.28, 0.30);
    vec4 w = mix(wTight, wLong, clamp(BCAS_GLOW2.x, 0.0, 1.0));

    // warmth: wider levels lean harder toward the warm palette; the core
    // keeps the emitter's own hue (that is what makes glow "infuse").
    vec3 pal = mix(vec3(0.90, 0.96, 1.0), vec3(1.0, 0.92, 0.82),
                   BCAS_GLOW.w * 0.5 + 0.5);
    l0 *= mix(vec3(1.0), pal, 0.10);
    l1 *= mix(vec3(1.0), pal, 0.35);
    l2 *= mix(vec3(1.0), pal, 0.65);
    l3 *= pal * BCAS_GLOW2.w;

    // long-tail lift: dim halos breathe out, hot halos stay put
    float hl = bcas_luma(l3);
    float tail = clamp(1.0 - hl * 4.0, 0.0, 1.0);
    l3 *= 1.0 + BCAS_GLOW3.x * 0.5 * tail * tail;

    vec3 bloom = l0 * w.x + l1 * w.y + l2 * w.z + l3 * w.w;

    // single linear saturation shaping
    float bl = bcas_luma(bloom);
    bloom = mix(vec3(bl), bloom, BCAS_GLOW2.y);

    // hue-preserving soft shoulder: caps additive stacking by scaling RGB
    // uniformly so colours survive instead of bleaching to white
    bl = bcas_luma(bloom);
    float bc = bl / (1.0 + bl * 0.5);
    bloom *= mix(1.0, bc / max(bl, 1e-4), smoothstep(0.6, 1.4, bl));

    vec3 final = src + bloom * BCAS_GLOW.x;

    // optional light wrap (default 0): breathable haze in shadowed air
    float srcL = clamp(bcas_luma(src), 0.0, 1.0);
    float shadow = 1.0 - srcL;
    final += l3 * (BCAS_GLOW3.y * shadow * shadow);

    // optional rim (default 0): thin light edge, gated by real halo energy.
    // The hl guard also skips the four extra full-res taps on the (majority)
    // of pixels with no halo, so the default-cost path stays cheap.
    if (BCAS_GLOW3.z > 0.001 && hl > 0.01)
    {
        vec2 px = SCREEN_PARAMS.zw;
        if (px.x > 0.0 && px.y > 0.0)
        {
            float Lr = bcas_luma(texture2D(SAMPLER[0], uv + vec2(px.x * 2.0, 0.0)).rgb);
            float Ll = bcas_luma(texture2D(SAMPLER[0], uv - vec2(px.x * 2.0, 0.0)).rgb);
            float Lu = bcas_luma(texture2D(SAMPLER[0], uv + vec2(0.0, px.y * 2.0)).rgb);
            float Ld = bcas_luma(texture2D(SAMPLER[0], uv - vec2(0.0, px.y * 2.0)).rgb);
            float edge = max(max(abs(srcL - Lr), abs(srcL - Ll)),
                             max(abs(srcL - Lu), abs(srcL - Ld)));
            float haloMask = clamp(hl * 6.0, 0.0, 1.0);
            final += vec3(1.12, 1.03, 0.90) * (BCAS_GLOW3.z * 1.2 * edge * haloMask);
        }
    }

    // global highlight compression (panel "compress")
    final = final / (1.0 + final * BCAS_GLOW2.z);

    // final hue-preserving shoulder: tame stacked brightness above a knee
    // without bleaching the emitter's colour
    float fl = bcas_luma(final);
    if (fl > 0.88)
    {
        float cl = 0.88 + (fl - 0.88) / (1.0 + (fl - 0.88) * 1.2);
        final *= cl / fl;
    }
    gl_FragColor = vec4(final, 1.0);
}
