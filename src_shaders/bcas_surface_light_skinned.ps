#define SKINNED
#if defined( GL_ES )
precision mediump float;
#endif

uniform mat4 MatrixW;


#if defined( TRIPLE_ATLAS )
    uniform sampler2D SAMPLER[6];
#else
    uniform sampler2D SAMPLER[5];
#endif

#ifndef LIGHTING_H
#define LIGHTING_H

#if !defined( UI_CC )
// Lighting
varying vec3 PS_POS;
#endif

// xy = min, zw = max
uniform vec4 LIGHTMAP_WORLD_EXTENTS;

#define LIGHTMAP_TEXTURE SAMPLER[3]

#ifndef LIGHTMAP_TEXTURE
	#error If you use lighting, you must #define the sampler that the lightmap belongs to
#endif

#if defined( UI_CC )
vec3 CalculateLightingContribution(vec2 pos)
{
	vec2 uv = ( pos - LIGHTMAP_WORLD_EXTENTS.xy ) * LIGHTMAP_WORLD_EXTENTS.zw;
	return texture2D( LIGHTMAP_TEXTURE, uv.xy ).rgb;
}
#else
vec3 CalculateLightingContribution()
{
	vec2 uv = ( PS_POS.xz - LIGHTMAP_WORLD_EXTENTS.xy ) * LIGHTMAP_WORLD_EXTENTS.zw;
	return texture2D( LIGHTMAP_TEXTURE, uv.xy ).rgb;
}

vec3 CalculateLightingContribution( vec3 normal )
{
	return vec3( 1, 1, 1 );
}
#endif

#endif //LIGHTING.h


varying vec3 PS_TEXCOORD;

uniform vec4 TIMEPARAMS;

uniform mat4 COLOUR_XFORM;
uniform vec3 PARAMS;
uniform vec3 FLOAT_PARAMS;
uniform vec4 HAUNTPARAMS;
uniform vec4 HAUNTPARAMS2;
uniform vec4 OCEAN_BLEND_PARAMS;
uniform vec3 CAMERARIGHT;
// >>> BCAS/DA: daylight_architecture relief lighting, ported with permission.
// Parameter source: FLOAT_PARAMS = (camera-space sun azimuth THETA, -elevation(rad),
// -strength). See BCAS_* comments below for why this replaced DA's own
// (horizontal sun, elevation, strength) encoding -- in short, a single
// horizontal component cannot express "the light is behind the object".
// The camera axes CANNOT be recovered here: the pixel stage of anim.ksh binds
// neither CAMERARIGHT nor MatrixV (MatrixV is a vertex-stage binding, and
// anim_skinned.ksh has no camera matrix at all), and the sprite's own axis is
// quantised to four facings on multi-faced entities, which is what made the lit
// face stick between the cardinal directions.
varying vec2 DA_LOCAL_METRES;

vec3 DA_ApplySunlight(vec3 source_rgb)
{
	// 2026-09-21 packed bus. An entity shader has exactly one mod-writable
	// channel, so the y/z slots carry a payload (layout and rationale in
	// BCAS-Studio/scripts/bcas_surface_light.lua, M.PackY; the spec is proven by
	// tools/bus_pack_proof.py: lossless round-trip, the 12-bit azimuth step is
	// worth 0.114 of an 8bit level, the 11-bit elevation step moves the shadow
	// length by 0.22%).
	//   y = -(el_q + 2^11 * (warm_q + 64 * con_q))
	//   z = -(thb_q + 2^12 * str_q)
	// x carries a payload too since 2026-09-22 (spec: M.PackX in
	// BCAS-Studio/scripts/bcas_surface_light.lua):
	//   x = cool_q + 64*dark_q + 4096*f_q
	// This pass takes the LOW 12 bits (x mod 4096 = cool_q + 64*dark_q, the two
	// backlight sliders) and ignores the HIGH half (f_q, the shadow azimuth):
	// for the lit face it wants theta_blend, the light-following azimuth, which
	// is what the z slot holds. The two consumers need different angles at the
	// same instant, hence two angle fields.
	float py = -FLOAT_PARAMS.y;
	float pz = -FLOAT_PARAMS.z;
	float bcas_pay = mod(FLOAT_PARAMS.x, 4096.0);
	float bcas_scool = (mod(bcas_pay, 64.0) + 1.0) * 0.015625;
	float bcas_sdark = (floor(bcas_pay / 64.0) + 1.0) * 0.015625;
	float bcas_el = (mod(py, 2048.0) / 2047.0) * 1.5707963268;
	float bcas_warm = (mod(floor(py / 2048.0), 64.0) + 1.0) * 0.015625;
	float bcas_contrast = (floor(py / 131072.0) + 1.0) * 0.015625;
	float strength = (floor(pz / 4096.0) / 255.0) * 1.5;
	float elevation = clamp(bcas_el * 0.63661977, 0.0, 1.0);
	float theta = (mod(pz, 4096.0) / 4096.0) * 6.2831853072 - 3.1415926536;
	float sun_x = cos(theta);
	float sun_front = sin(theta);
	float warmth = 1.0 - smoothstep(0.10, 0.85, elevation);

	// 1. Rounded relief normal in entity coordinates (artistic sprite
	//    approximation -- not mesh normals, no reconstructed 3D object).
	float local_x = DA_LOCAL_METRES.x;
	float normal_x = local_x / sqrt(local_x * local_x + 0.72);
	float roof = smoothstep(0.30, 2.30, DA_LOCAL_METRES.y);
	float normal_up = 0.22 + roof * 0.28;
	float normal_front = sqrt(max(0.06, 1.0 - normal_x * normal_x));
	float sun_y = sin(bcas_el);
	vec2 sun2 = normalize(vec2(sun_x, sun_y * 2.60 + 0.18));
	float diffuse = max(normal_x * sun2.x + normal_up * 1.35 * sun2.y
		+ normal_front * 0.50 * sun_front, 0.0);

	// 2. Lit face. The tree BODY is a solid occluder: when backlit, the face
	// toward the camera must stay dark and steeped in the cool ambient -- it
	// must NEVER glow from inside (that was the translucent-canopy mistake).
	float direct = smoothstep(0.08, 0.90, diffuse);
	float grazing = 1.0 - elevation;
	vec3 warm_sun = mix(vec3(1.0, 0.95, 0.82), vec3(1.0, 0.65, 0.22), warmth);
	// The two user sliders (packed into y, see the decode block above):
	//   warm/cool -- complementary tint on the lit and the shaded side. The
	//     endpoints are strictly symmetric about 0.5, so the factory value
	//     decodes to exactly (1,1,1) and the shipped look is bit-identical
	//     (that is criterion 4 in tools/bus_pack_proof.py).
	//   contrast  -- one amplitude for lit lift, shade drop, rim and root
	//     contact; 0.5 maps to 1.0 (factory look unchanged).
	vec3 bcas_lit_hue = mix(vec3(0.851, 0.979, 1.200), vec3(1.149, 1.021, 0.800), bcas_warm);
	vec3 bcas_shade_hue = mix(vec3(1.149, 1.021, 0.800), vec3(0.851, 0.979, 1.200), bcas_warm);
	float bcas_amp = 0.40 + 1.20 * bcas_contrast;
	// The two backlight sliders (low 12 bits of x, decode block above) touch
	// the SHADED side ONLY -- the lit lift, the rim and the root contact keep
	// following q_contrast exactly as they did.
	//   scool -- shade-only temperature. The endpoints are symmetric about
	//     (1,1,1), so the factory 0.5 is exactly neutral; the cool end raises B
	//     and cuts R, which is what makes a shaded face read as sky-lit rather
	//     than sooty.
	//   sdark -- shade-only amplitude; 0.5 maps to 1.0 (factory look unchanged).
	vec3 bcas_shade_temp = mix(vec3(1.149, 1.021, 0.800), vec3(0.851, 0.979, 1.200), bcas_scool);
	float bcas_shade_amp = 0.40 + 1.20 * bcas_sdark;
	vec3 sky_ambient = vec3(0.14, 0.18, 0.26); // cool sky fill
	vec3 lit_color = source_rgb * (vec3(1.0)
		+ strength * bcas_amp * direct * (0.32 + grazing * 0.60) * warm_sun * bcas_lit_hue);
	// The sky fill MUST be multiplied by the pixel's own diffuse colour, never
	// added as a constant. Premultiplied art has rgb == 0 wherever it is
	// transparent, so `sky_ambient * source_rgb` is identically zero on every
	// invisible texel -- which is what keeps the atlas margin from becoming a
	// glowing grey tile. A constant addend here lifted rgb to ~0.03 while alpha
	// stayed ~0.01 on the slices' soft edges: rgb > a breaks the premultiplied
	// invariant and the blend equation paints it as additive light.
	vec3 shaded_color = mix(lit_color,
		lit_color * 0.70 + (sky_ambient * bcas_shade_hue * bcas_shade_temp) * source_rgb * 0.5,
		(1.0 - direct) * 0.45 * strength * bcas_shade_amp);

	// 3. Clean rim light -- the eclipse-ring gold edge, and nothing else.
	// back_factor: strictly backlit only (max, not a wrap window -- the wrap
	// version lit side faces too). rim_edge: pow 3 keeps the band tight at the
	// silhouette. rim_mask is THE anti-mosaic guard: the engine blends
	// premultiplied, so additive rgb on an alpha=0 texel paints a glowing
	// square -- the transparent margin of the atlas showed up as the yellow
	// staircase. Premultiplied art has rgb == 0 in those texels, so gating by
	// the pixel's own colour intensity forces the glow to exactly 0 there and
	// locks the band onto the painted edge ink.
	float back_factor = max(-sun_front, 0.0);
	float rim_edge = pow(clamp(1.0 - normal_front, 0.0, 1.0), 3.0);
	float rim_mask = smoothstep(0.02, 0.25,
		max(source_rgb.r, max(source_rgb.g, source_rgb.b)));
	vec3 rim_glow = (warm_sun * bcas_lit_hue) * (strength * bcas_amp * 1.40
		* back_factor * rim_edge * rim_mask);

	// 4. Root contact shadow: darken the backlit side near the ground so the
	// long cast shadow reads as growing OUT of the tree's dark base (the two
	// physically bite into each other).
	float root_contact = (1.0 - direct)
		* (1.0 - smoothstep(0.0, 0.85, DA_LOCAL_METRES.y));
	shaded_color *= (1.0 - min(strength * bcas_amp * 0.35 * root_contact, 0.45));

	// strength = 0 restores the engine's pixel exactly (every term carries it).
	return max(shaded_color + rim_glow, vec3(0.0));
}
// <<< BCAS/DA

#define ALPHA_TEST PARAMS.x
#define LIGHT_OVERRIDE PARAMS.y
#define BLOOM_TOGGLE PARAMS.z

#if defined( FADE_OUT ) || defined( HAUNT )
    varying vec2 FADE_UV;
#endif


#if defined( FADE_OUT )
	uniform vec4 EROSION_PARAMS; 

	#if defined( HOLO )
		#define HOLO_SAMPLER			SAMPLER[2]
		#define HOLO_ERODE_INTENSITY	EROSION_PARAMS.x
		#define HOLO_Y_CUTOFF			EROSION_PARAMS.y
		#define NEGATIVE_HOLO_LERP		EROSION_PARAMS.z
	#else
    	#define ERODE_SAMPLER			SAMPLER[2]
		#define EROSION_MIN				EROSION_PARAMS.x
		#define EROSION_RANGE			EROSION_PARAMS.y
		#define EROSION_LERP			EROSION_PARAMS.z
	#endif
#endif

uniform vec4 OCEAN_WORLD_EXTENTS;
#define OCEAN_SAMPLER SAMPLER[4]

#if defined( HOLO )
	float filmSkipRand() // This should match the function with the same name in anim.vs
	{
		float steps = 12.;
		float c = fract(sin(ceil(TIMEPARAMS.x * steps) / steps) * 10000.);
		return (c * -.36) * step(.78, c);
	}
#endif

void main()
{
    vec4 colour;

#if defined( TRIPLE_ATLAS )
    if( PS_TEXCOORD.z < 0.5 )
    {
        colour.rgba = texture2D( SAMPLER[0], PS_TEXCOORD.xy );
    }
    else if( PS_TEXCOORD.z < 1.5 )
    {
        colour.rgba = texture2D( SAMPLER[1], PS_TEXCOORD.xy );
    }
    else
    {
        colour.rgba = texture2D( SAMPLER[5], PS_TEXCOORD.xy );
    }
#else
    if( PS_TEXCOORD.z < 0.5 )
    {
        colour.rgba = texture2D( SAMPLER[0], PS_TEXCOORD.xy );
    }
    else
    {
        colour.rgba = texture2D( SAMPLER[1], PS_TEXCOORD.xy );
    }
#endif

	if (BLOOM_TOGGLE == 1.0)
	{
		gl_FragColor.rgba = vec4(0, 0, 0, colour.a);
		return;
	}

    if(FLOAT_PARAMS.y > 0.0)
    {
    	if(PS_POS.y < FLOAT_PARAMS.x)
    	{
    		discard;
    	}
    }

#if defined ( FADE_OUT )
	if (colour.a >= ALPHA_TEST)
#else
	if (ALPHA_TEST > 0.0)
	{
		if (colour.a >= ALPHA_TEST)
		{
			gl_FragColor = colour.rgba;	
		}
		else
		{
			discard;
		}
	}
    else
#endif
    {
		gl_FragColor.rgba = colour.rgba * COLOUR_XFORM;
		gl_FragColor.rgb = min(gl_FragColor.rgb, gl_FragColor.a);

#if defined( FADE_OUT )
		#if defined( HOLO )
			if (PS_POS.y < (.36 - filmSkipRand()) * .096 + HOLO_Y_CUTOFF)
			{
				discard;
			}

			vec4 orig = gl_FragColor;
			
			vec2 lineUV = vec2(FADE_UV.x * 1., TIMEPARAMS.x * .16);
			float rgbLines = smoothstep(1., .75, texture2D( HOLO_SAMPLER, lineUV ).g);
			float alphaLines = step(HOLO_ERODE_INTENSITY - .01, texture2D( HOLO_SAMPLER, lineUV ).g);

			float filmGrainTime = ceil(TIMEPARAMS.x * 10.) * .1; // Grain runs on 1/10 framerate
			
			float grain = texture2D( HOLO_SAMPLER, FADE_UV.xy * 1. + mod(filmGrainTime * 192.7249753, 9e4)).b;
			float mask = grain * rgbLines;
			gl_FragColor.rgb *= .35 + mask * .65;
			
			// Color grading
			gl_FragColor.rgb = mix(gl_FragColor.rgb, vec3(.85, .68, .57), .05);

			// Fluctuating exposure
			float exposureAdd = texture2D( HOLO_SAMPLER, vec2(mod(TIMEPARAMS.x, 1.), mod(floor(TIMEPARAMS.x) / 256., 256.))).r;
			gl_FragColor.rgb += vec3(exposureAdd * .22);

			float baseAlpha = gl_FragColor.a;
			float alpha = baseAlpha * alphaLines;
			gl_FragColor = mix(orig, vec4(gl_FragColor.r * alpha, gl_FragColor.g * alpha, gl_FragColor.b * alpha, alpha), abs(NEGATIVE_HOLO_LERP));
		#else
			float height = texture2D( ERODE_SAMPLER, FADE_UV.xy).a;
			float erode_val = clamp( ( height - EROSION_MIN ) / EROSION_RANGE, 0.0, 1.0 );
			gl_FragColor.rgba = mix( gl_FragColor.rgba, gl_FragColor.rgba * erode_val, EROSION_LERP );
		#endif
#endif
		
		vec2 world_uv = ( PS_POS.xz - OCEAN_WORLD_EXTENTS.xy ) * OCEAN_WORLD_EXTENTS.zw;
		vec3 world_tint = texture2D( OCEAN_SAMPLER, world_uv ).rgb;
		gl_FragColor.rgb = mix(gl_FragColor.rgb, gl_FragColor.rgb * world_tint.rgb, OCEAN_BLEND_PARAMS.x);

        vec3 light = CalculateLightingContribution();

        gl_FragColor.rgb *= max( light.rgb, vec3( LIGHT_OVERRIDE, LIGHT_OVERRIDE, LIGHT_OVERRIDE ) );
		// >>> BCAS/DA: relief lighting on top of the engine's lightmap result
		gl_FragColor.rgb = DA_ApplySunlight(gl_FragColor.rgb);
		// >>> BCAS/PREMULT: the engine's own clamp lives at anim.ps.glsl:162,
		// BEFORE this injection point, so everything written above has escaped
		// the premultiplied invariant. Re-apply it here. With premultiplied
		// blending the result is SrcRGB + DestRGB * (1 - SrcA) -- any rgb above
		// alpha is not perceived as light on the object, it is composited as an
		// ADDITIVE surface pixel. That is exactly how the atlas' soft edges
		// (alpha ~0.01) turned every sprite slice into a grey translucent tile,
		// and how the backlit rim turned into a yellow staircase. Clamping to
		// alpha is what shuts both off: transparent air is now mathematically
		// incapable of receiving any light at all.
		gl_FragColor.rgb = min(gl_FragColor.rgb, vec3(gl_FragColor.a));
		// <<< BCAS/PREMULT
		// <<< BCAS/DA
#if defined( HAUNT )
		float xp = FADE_UV.x * 4.0;
		float yp = FADE_UV.y * 8.0;
		float zp = 0.0;

		// Add in a random base to desynchronise identical objects
		xp += HAUNTPARAMS.y;
		zp += HAUNTPARAMS.y;
		yp += HAUNTPARAMS.y;

		const float PI = 3.1415;
		const float TWO_PI = 2.0 * PI;

		xp *= 5.;
		yp *= 5.;
		zp *= 5.;

		float time = HAUNTPARAMS.x;

		float cx = 0.71;
		float cz = 0.71;

		float resx = cx * xp;
		float resz = cz * zp;

		float x = resx+resz;
		float y = yp;

		// scale the effect
		x *= HAUNTPARAMS.w;	
		y *= HAUNTPARAMS.w;

		float strength = HAUNTPARAMS.z;
#if defined(BLOOM)
		// Hmmm, still unsure if it looks better with bloom at a different rate. It adds some obfuscation to the pattern
		time *= -2.0;
#else
		time *= 3.0;
#endif
		float pix = 
        (
              (sin((x + time * 7.0) * HAUNTPARAMS2.x))
            + (cos((y + time * 1.5)  * HAUNTPARAMS2.y))
            + (sin((x + y + 3.0 * time ) / (16.0 + 0.3 * sin(time / 100.0))))
            + (sin(sqrt((x * x + y * y)) * HAUNTPARAMS2.z))
        ) / 4.0;

		// either this:
		pix = 0.5 + 0.5 * sin(pix * PI);
		// or this
		//pix = 0.5 + 0.5 * pix;
		//pix = 0.5 + 0.5 * sin(pix * TWO_PI);

		float orig_a = gl_FragColor.a;
		// pix is the new alpha
		// Take the alpha out of the source pixel
		gl_FragColor.rgb /= orig_a;	

//if (pix > 0.8) pix = 0.8;
//if (pix < 0.95) pix = 0.0;

		float r = gl_FragColor.r;
		float g = gl_FragColor.g;
		float b = gl_FragColor.b;
		float r2 = r * 3.0;
		float g2 = g * 3.0;
		float b2 = b * 3.0;
		vec3 rgb2 = vec3(r2,g2,b2);

		pix = pix * strength;
		gl_FragColor.rgb = (1.0-pix) * gl_FragColor.rgb + pix * rgb2;

		// Multiply in the original alpha
		gl_FragColor.r *= orig_a;
		gl_FragColor.g *= orig_a;
		gl_FragColor.b *= orig_a;

#if defined(BLOOM)
		// This condition isn't needed but if I take it out opengl errs out because sampler accesses are optimized out
//		if ((HAUNTPARAMS.y > 0.5))	// 1 in the bloompass. Could also multiply instead
		{
			float v = pix;
			v *= 0.5;
			v *= orig_a;
			v *= strength;
			// To stop OpenGL on crapping out on unused samplers.....
			gl_FragColor = gl_FragColor * 0.0001 + vec4(v,v,v,orig_a) * 0.9999;
		}
#endif
		// To see the plasma

#endif  
    }


// -- BUG1 clip mask (write side) ------------------------------------------
// 1px blue checkerboard, +/-12/255, on EVERY sprite pixel that is not
// nearly transparent (a >= 24/255): nothing else may leak the shadow
// through (author report 2026-09-21: white heads and birch bark still did).
// The sign is chosen so the offset always fits the premultiplied range: while
// b + 12 <= a * 255 the mark follows the phase (the usual case), otherwise it
// goes against it. At least one sign always fits -- b <= a (the engine clamps
// rgb to a at anim.ps.glsl:162, before this injection) plus b + 12 > a imply
// b > a - 12 >= 12, hence b - 12 > 0. The reader (bcas_merged_glow.ps)
// measures BOTH hypotheses and cancels the one it measured, so a white or
// near-saturated pixel is cancelled exactly as well.
float bcas_mk_b = gl_FragColor.b * 255.0;
float bcas_mk_hi = gl_FragColor.a * 255.0 - 12.0;
if( bcas_mk_hi >= 12.0 )
{
 float bcas_mk_p = mod( floor(gl_FragCoord.x) + floor(gl_FragCoord.y), 2.0 ) * 2.0 - 1.0;
 float bcas_mk_s = ( bcas_mk_b <= bcas_mk_hi ) ? 1.0 : -1.0;
 gl_FragColor.b = max( bcas_mk_b + bcas_mk_p * bcas_mk_s * 12.0, 0.0 ) / 255.0;
}



#if defined ( FADE_OUT )
	else
	{
		discard;
	}
#endif
}
